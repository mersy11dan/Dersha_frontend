# ---------------------------------------------------------------------------
# Dersha / CELL API configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Origin allowed to call this API (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# --- Database (MariaDB / MySQL) --------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dirsha_db

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- Partner integrations ---------------------------------------------------
# MOCK  = simulated responses, no credentials required (default for development)
# LIVE  = real partner endpoints, requires the credentials below
PARTNER_MODE=MOCK

# Fayda National ID Program (eKYC)
FAYDA_API_BASE_URL=https://id.gov.et
FAYDA_PARTNER_API_KEY=
FAYDA_MIN_CONFIDENCE=95

# Payment switch (Telebirr / EthSwitch / CBE Birr)
PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_API_KEY=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Custodian bank SFTP (nightly MT940 reconciliation)
CUSTODIAN_SFTP_HOST=
CUSTODIAN_SFTP_USER=
CUSTODIAN_SFTP_PASSWORD=
CUSTODIAN_STATEMENT_DIR=./fixtures/mt940

# --- Platform economics (see product doc) -----------------------------------
DIVIDEND_WITHHOLDING_TAX_RATE=0.10
CREATOR_ROYALTY_RATE=0.005
AMM_LIQUIDITY_HAIRCUT=0.12
AMM_NO_MATCH_WINDOW_SECONDS=60
OWNER_VESTING_LOCK_MONTHS=6
RECONCILIATION_CRON=0 4 * * *
RECONCILIATION_TIMEZONE=Africa/Addis_Ababa
